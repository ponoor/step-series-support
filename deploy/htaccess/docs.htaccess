# STEP series docs: old WordPress URLs -> the new site (301). Put this in ~/web/ponoor.com/docs/.htaccess.
# Generated by tools/gen_htaccess.py from docs/_redirects_map.md. Do not edit by hand.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^/?$ https://ponoor.com/docs/step-series/ [NC,R=301,L]
RewriteRule ^emb-step400/?$ https://ponoor.com/docs/step-series/hardware/emb-step400/ [NC,R=301,L]
RewriteRule ^emb-step400/commands/?$ https://ponoor.com/docs/step-series/guides/electromagnetic-brake/ [NC,R=301,L]
RewriteRule ^emb-step400/connection/?$ https://ponoor.com/docs/step-series/connections/electromagnetic-brake-wiring/ [NC,R=301,L]
RewriteRule ^emb-step400/howtowork/?$ https://ponoor.com/docs/step-series/guides/electromagnetic-brake/ [NC,R=301,L]
RewriteRule ^emb-step400/specifications/?$ https://ponoor.com/docs/step-series/hardware/emb-step400/ [NC,R=301,L]
RewriteRule ^en/step-series/settings/setup-with-a-microsd-card/?$ https://ponoor.com/docs/step-series/connections/microsd-card/ [NC,R=301,L]
RewriteRule ^step100-200/?$ https://ponoor.com/docs/step-series/step100-200/ [NC,R=301,L]
RewriteRule ^step100-200/assemble/?$ https://ponoor.com/docs/step-series/step100-200/assemble/ [NC,R=301,L]
RewriteRule ^step100-200/assemble/connections/?$ https://ponoor.com/docs/step-series/step100-200/assemble/connections/ [NC,R=301,L]
RewriteRule ^step100-200/assemble/step100/?$ https://ponoor.com/docs/step-series/step100-200/assemble/step100/ [NC,R=301,L]
RewriteRule ^step100-200/assemble/step200/?$ https://ponoor.com/docs/step-series/step100-200/assemble/step200/ [NC,R=301,L]
RewriteRule ^step100-200/get-the-materials/?$ https://ponoor.com/docs/step-series/step100-200/get-the-materials/ [NC,R=301,L]
RewriteRule ^step100-200/upload-the-sketch/?$ https://ponoor.com/docs/step-series/step100-200/upload-the-sketch/ [NC,R=301,L]
RewriteRule ^step100-200/usage/?$ https://ponoor.com/docs/step-series/step100-200/usage/ [NC,R=301,L]
RewriteRule ^step400/?$ https://ponoor.com/docs/step-series/ [NC,R=301,L]
RewriteRule ^step400/functional-description/homing-and-position-management/?$ https://ponoor.com/docs/step-series/guides/homing-and-position/ [NC,R=301,L]
RewriteRule ^step400/functional-description/servo-mode/?$ https://ponoor.com/docs/step-series/guides/servo-mode/ [NC,R=301,L]
RewriteRule ^step400/functional-description/voltage-mode-and-current-mode/?$ https://ponoor.com/docs/step-series/guides/voltage-and-current-mode/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/absolute-position-management/?$ https://ponoor.com/docs/step-series/reference/position-management/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/automatically-sent-messages-from-step-400/?$ https://ponoor.com/docs/step-series/reference/automatically-sent-messages/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/brake/?$ https://ponoor.com/docs/step-series/reference/brake/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/homing/?$ https://ponoor.com/docs/step-series/reference/homing/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/motor-control/?$ https://ponoor.com/docs/step-series/reference/motor-control/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/speed-profile/?$ https://ponoor.com/docs/step-series/reference/speed-profile/ [NC,R=301,L]
RewriteRule ^step400/osc-command-reference/voltage-and-current-mode-settings/?$ https://ponoor.com/docs/step-series/reference/voltage-and-current-mode-settings/ [NC,R=301,L]

# Anything that is not a file or a directory here goes to WordPress (its old-slug redirects and its 404 page).
# Without this, RewriteEngine On in this directory would hide the rules of the top-level .htaccess.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
