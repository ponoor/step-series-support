# STEP series docs: old WordPress URLs -> the new site (301). Put this in ~/web/ponoor.com/docs/step-series/.htaccess.
# Generated by tools/gen_htaccess.py from docs/_redirects_map.md. Do not edit by hand.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^functional-description/?$ https://ponoor.com/docs/step-series/guides/communication-and-messages/ [NC,R=301,L]
RewriteRule ^functional-description/homing-and-absolute-position-management/?$ https://ponoor.com/docs/step-series/guides/homing-and-position/ [NC,R=301,L]
RewriteRule ^functional-description/homing-and-position-management/?$ https://ponoor.com/docs/step-series/guides/homing-and-position/ [NC,R=301,L]
RewriteRule ^functional-description/servo-mode/?$ https://ponoor.com/docs/step-series/guides/servo-mode/ [NC,R=301,L]
RewriteRule ^functional-description/speed-profile-and-type-of-motor-motions/?$ https://ponoor.com/docs/step-series/guides/speed-profile-and-motions/ [NC,R=301,L]
RewriteRule ^functional-description/voltage-mode-and-current-mode/?$ https://ponoor.com/docs/step-series/guides/voltage-and-current-mode/ [NC,R=301,L]
RewriteRule ^osc-command-reference/?$ https://ponoor.com/docs/step-series/reference/ [NC,R=301,L]
RewriteRule ^osc-command-reference/absolute-position-management/?$ https://ponoor.com/docs/step-series/reference/position-management/ [NC,R=301,L]
RewriteRule ^osc-command-reference/alarm-settings/?$ https://ponoor.com/docs/step-series/reference/alarm-settings/ [NC,R=301,L]
RewriteRule ^osc-command-reference/automatically-sent-messages-from-step-400/?$ https://ponoor.com/docs/step-series/reference/automatically-sent-messages/ [NC,R=301,L]
RewriteRule ^osc-command-reference/brake/?$ https://ponoor.com/docs/step-series/reference/brake/ [NC,R=301,L]
RewriteRule ^osc-command-reference/diff_400_800_command/?$ https://ponoor.com/docs/step-series/reference/differences-step400-step800/ [NC,R=301,L]
RewriteRule ^osc-command-reference/home-limit-sensors/?$ https://ponoor.com/docs/step-series/reference/home-and-limit-sensors/ [NC,R=301,L]
RewriteRule ^osc-command-reference/homing/?$ https://ponoor.com/docs/step-series/reference/homing/ [NC,R=301,L]
RewriteRule ^osc-command-reference/motor-control/?$ https://ponoor.com/docs/step-series/reference/motor-control/ [NC,R=301,L]
RewriteRule ^osc-command-reference/motor-driver-settings/?$ https://ponoor.com/docs/step-series/reference/motor-driver-settings/ [NC,R=301,L]
RewriteRule ^osc-command-reference/motordriver-settings/?$ https://ponoor.com/docs/step-series/reference/motor-driver-settings/ [NC,R=301,L]
RewriteRule ^osc-command-reference/servo-mode/?$ https://ponoor.com/docs/step-series/reference/servo-mode_reference/ [NC,R=301,L]
RewriteRule ^osc-command-reference/speed-profile/?$ https://ponoor.com/docs/step-series/reference/speed-profile/ [NC,R=301,L]
RewriteRule ^osc-command-reference/system-settings/?$ https://ponoor.com/docs/step-series/reference/system-settings/ [NC,R=301,L]
RewriteRule ^osc-command-reference/voltage-and-current-mode-settings/?$ https://ponoor.com/docs/step-series/reference/voltage-and-current-mode-settings/ [NC,R=301,L]
RewriteRule ^settings/?$ https://ponoor.com/docs/step-series/connections/power-supply-and-motor/ [NC,R=301,L]
RewriteRule ^settings/example-parameter-values-for-example-steppers/?$ https://ponoor.com/docs/step-series/connections/example-parameters/ [NC,R=301,L]
RewriteRule ^settings/network-and-dip-switch/?$ https://ponoor.com/docs/step-series/connections/network-and-dip-switch/ [NC,R=301,L]
RewriteRule ^settings/power-supply-and-motor/?$ https://ponoor.com/docs/step-series/connections/power-supply-and-motor/ [NC,R=301,L]
RewriteRule ^settings/sensor-and-switch/?$ https://ponoor.com/docs/step-series/connections/sensors-and-switches/ [NC,R=301,L]
RewriteRule ^settings/setup-with-a-microsd-card/?$ https://ponoor.com/docs/step-series/connections/microsd-card/ [NC,R=301,L]
RewriteRule ^setup/example-parameter-values-for-example-steppers/?$ https://ponoor.com/docs/step-series/connections/example-parameters/ [NC,R=301,L]
RewriteRule ^setup/network-and-dip-switch/?$ https://ponoor.com/docs/step-series/connections/network-and-dip-switch/ [NC,R=301,L]
RewriteRule ^setup/power-supply-and-motor/?$ https://ponoor.com/docs/step-series/connections/power-supply-and-motor/ [NC,R=301,L]
RewriteRule ^setup/sensor-and-switch/?$ https://ponoor.com/docs/step-series/connections/sensors-and-switches/ [NC,R=301,L]
RewriteRule ^setup/setup-with-a-microsd-card/?$ https://ponoor.com/docs/step-series/connections/microsd-card/ [NC,R=301,L]
RewriteRule ^technical-information/?$ https://ponoor.com/docs/step-series/maintenance/firmware-update/ [NC,R=301,L]
RewriteRule ^technical-information/compile-the-arduino-sketch/?$ https://ponoor.com/docs/step-series/maintenance/compile-the-arduino-sketch/ [NC,R=301,L]
RewriteRule ^technical-information/diagnosis/?$ https://ponoor.com/docs/step-series/maintenance/usb-serial-diagnosis/ [NC,R=301,L]
RewriteRule ^technical-information/firmware-update/?$ https://ponoor.com/docs/step-series/maintenance/firmware-update/ [NC,R=301,L]
RewriteRule ^technical-information/hardware-step400/?$ https://ponoor.com/docs/step-series/hardware/step400/ [NC,R=301,L]
RewriteRule ^technical-information/hardware-step800/?$ https://ponoor.com/docs/step-series/hardware/step800/ [NC,R=301,L]
RewriteRule ^tutorial/?$ https://ponoor.com/docs/step-series/getting-started/quickstart/ [NC,R=301,L]
# /docs/step-series/ is the top page of the new site: no redirect.

# Anything that is not a file or a directory here goes to WordPress (its old-slug redirects and its 404 page).
# Without this, RewriteEngine On in this directory would hide the rules of the top-level .htaccess.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
